        self.table.setSelectionMode(QAbstractItemView.SelectionMode.NoSelection)
        self.table.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self.table.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.table.customContextMenuRequested.connect(self.show_sensor_context_menu)

        self.status_label = QLabel("Waiting for sensor readings...")

        self.interval_spin = QSpinBox()
        self.interval_spin.setRange(1, 60)
        self.interval_spin.setValue(2)
        self.interval_spin.setSuffix(" s")
        self.interval_spin.setToolTip("Refresh interval (seconds)")
        self.interval_spin.valueChanged.connect(lambda _value: self.update_timer_interval())

        self.category_combo = QComboBox()
