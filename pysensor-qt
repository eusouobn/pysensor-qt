def translate_key(key: str) -> str:
    """Convert 'Temperatura|amdgpu/edge' to 'Temp|amdgpu/edge'."""
    if "|" not in key:
        return key

    category, rest = key.split("|", 1)
    category = CATEGORY_EN.get(category, category)

    if "/" in rest:
        chip, label = rest.split("/", 1)
        for old, new in LABEL_EN.items():
            if label == old:
                label = new
                break
            if label.endswith(" " + old):
                label = label[: -(len(old) + 1)] + " " + new
                break
        rest = f"{chip}/{label}"

    return f"{category}|{rest}"


def migrate_settings(settings: dict) -> dict:
    """Migrate saved Portuguese settings to the new English format."""
    for field in ("hidden_sensors", "favorite_sensors"):
        values = settings.get(field)
        if isinstance(values, list):
            settings[field] = [translate_key(str(value)) for value in values]

    for field in ("hidden_sensor_info", "favorite_sensor_info"):
        info = settings.get(field)
        if isinstance(info, dict):
            migrated = {}
            for key, value in info.items():
                if isinstance(value, dict):
                    value = dict(value)
                    if "category" in value:
                        value["category"] = CATEGORY_EN.get(value["category"], value["category"])
                migrated[translate_key(str(key))] = value
            settings[field] = migrated

    visible = settings.get("category_visible")
    if isinstance(visible, dict):
        settings["category_visible"] = {
            CATEGORY_EN.get(key, key): enabled for key, enabled in visible.items()
        }

    if settings.get("order_mode") == "Categoria":
        settings["order_mode"] = "Category"

    return settings


def load_settings() -> dict:
    default = {
        "hidden_sensors": [],
        "hidden_sensor_info": {},
        "favorite_sensors": [],
        "favorite_sensor_info": {},
        "show_only_favorites": False,
        "category_visible": {category: True for category in CATEGORIES},
        "hide_zero": False,
        "fit_on_startup": True,
        "window_size": [720, 380],
    }

    try:
        if SETTINGS_PATH.exists():
            loaded = json.loads(SETTINGS_PATH.read_text(encoding="utf-8"))
            if isinstance(loaded, dict):
                default.update(loaded)
    except Exception:
        pass

    default = migrate_settings(default)

    # Make sure new categories default to visible.
    visible = default.get("category_visible", {})
    if not isinstance(visible, dict):
        visible = {}
    for category in CATEGORIES:
        visible.setdefault(category, True)
    default["category_visible"] = visible

    if not isinstance(default.get("hidden_sensors"), list):
        default["hidden_sensors"] = []

    if not isinstance(default.get("hidden_sensor_info"), dict):
        default["hidden_sensor_info"] = {}

    if not isinstance(default.get("favorite_sensors"), list):
        default["favorite_sensors"] = []

    if not isinstance(default.get("favorite_sensor_info"), dict):
        default["favorite_sensor_info"] = {}

    default["show_only_favorites"] = bool(default.get("show_only_favorites", False))
    default["fit_on_startup"] = bool(default.get("fit_on_startup", True))

    saved_size = default.get("window_size")
    if not (isinstance(saved_size, list) and len(saved_size) == 2):
        default["window_size"] = [720, 380]

    return default


def save_settings(settings: dict):
    try:
        SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
        SETTINGS_PATH.write_text(
            json.dumps(settings, indent=2, ensure_ascii=False),
            encoding="utf-8",
        )
    except Exception:
        pass


def read_text(path: Path) -> str:
    try:
        return path.read_text(errors="ignore").strip()
    except Exception:
        return ""


def read_int(path: Path):
    try:
        return int(read_text(path))
    except Exception:
        return None


def nice_name(text: str) -> str:
    text = str(text).strip()
    text = re.sub(r"\s+", " ", text)
    return text or "sensor"


def clean_hardware_name(name: str) -> str:
    name = nice_name(name)
    name = name.replace("(R)", "").replace("(TM)", "")
    name = re.sub(r"\s+CPU\s*@.*$", "", name, flags=re.IGNORECASE)
    name = re.sub(r"\s+Processor\s*$", "", name, flags=re.IGNORECASE)
    return re.sub(r"\s+", " ", name).strip()


@lru_cache(maxsize=1)
def get_cpu_model() -> str:
    cpuinfo = Path("/proc/cpuinfo")
    if cpuinfo.exists():
        for line in cpuinfo.read_text(errors="ignore").splitlines():
            if ":" not in line:
                continue

            key, value = line.split(":", 1)
            if key.strip().lower() in {"model name", "hardware"}:
                value = clean_hardware_name(value)
                if value:
                    return value

    lscpu = shutil.which("lscpu")
    if lscpu:
        try:
            result = subprocess.run(
                [lscpu],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                timeout=3,
                check=False,
            )
            for line in result.stdout.splitlines():
                if line.lower().startswith("model name:"):
                    return clean_hardware_name(line.split(":", 1)[1])
        except Exception:
            pass

    return "CPU"


def find_command(name: str):
    candidates = [
        shutil.which(name),
        f"/usr/bin/{name}",
        f"/usr/local/bin/{name}",
        f"/run/current-system/sw/bin/{name}",
        f"/run/opengl-driver/bin/{name}",
    ]

    for candidate in candidates:
        if candidate and Path(candidate).exists():
            return candidate

    return None


def run_short(command: list[str]) -> str:
    try:
        result = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=3,
            check=False,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except Exception:
        pass

    return ""


def format_gb(gb: float) -> str:
    """
    Show RAM/VRAM in GB only to avoid visual confusion.
    """
    return f"{gb:.1f} GB"


def shorten_gpu_name(name: str) -> str:
    name = clean_hardware_name(name)

    replacements = [
        ("NVIDIA Corporation", "NVIDIA"),
        ("Advanced Micro Devices, Inc.", "AMD"),
        ("ATI Technologies Inc.", "AMD"),
        ("[AMD/ATI]", "AMD"),
        ("VGA compatible controller:", ""),
        ("3D controller:", ""),
        ("Display controller:", ""),
    ]

    for old, new in replacements:
        name = name.replace(old, new)

    name = re.sub(r"\s+\(rev\s+[0-9a-fA-F]+\)$", "", name)
    name = re.sub(r"\s+\[[0-9a-fA-F]{4}:[0-9a-fA-F]{4}\]", "", name)
    name = re.sub(r"\s+", " ", name).strip()

    name = name.replace("NVIDIA NVIDIA", "NVIDIA", 1)
    name = name.replace("AMD AMD", "AMD", 1)

    return name


@lru_cache(maxsize=1)
def get_nvidia_gpu_model() -> str:
    nvidia_smi = find_command("nvidia-smi")
    if nvidia_smi:
        result = run_short([
            nvidia_smi,
            "--query-gpu=name",
            "--format=csv,noheader,nounits",
        ])
        first = result.splitlines()[0].strip() if result else ""
        if first:
            return shorten_gpu_name(first)

    return "NVIDIA GPU"


@lru_cache(maxsize=1)
def get_amd_gpu_model() -> str:
    lspci = find_command("lspci")
    if lspci:
        result = run_short([lspci, "-mm"])
        for line in result.splitlines():
            low = line.lower()
            if ("vga" in low or "3d controller" in low or "display controller" in low) and (
                "amd" in low or "advanced micro devices" in low or "ati" in low
            ):
                fields = re.findall(r'"([^"]*)"', line)
                if len(fields) >= 3:
                    model = fields[2]
                    if len(fields) > 3:
                        model = f"{model} {fields[3]}"
                    return shorten_gpu_name(model.strip())
                return shorten_gpu_name(line)

    return "AMD GPU"


def normalize_label(label: str) -> str:
    original = nice_name(label)
    low = original.lower()

    mapping = {
        "cpu": "CPU",
        "ram": "RAM",
        "tctl": "CPU Tctl",
        "tdie": "CPU Tdie",
        "tccd1": "CPU CCD 1",
        "tccd2": "CPU CCD 2",
        "edge": "GPU Edge",
        "junction": "GPU Junction",
        "mem": "GPU memory",
        "memory": "Memory",
        "composite": "Composite",
    }

    if low in mapping:
        return mapping[low]

    if "amd tsi" in low or "tsi addr" in low:
        return "AMD CPU via board"

    if low.startswith("fan") and low[3:].isdigit():
        return f"Fan {low[3:]}"

    if low.startswith("pwm") and low[3:].isdigit():
        return f"PWM {low[3:]}"

    if low.startswith("in") and low[2:].isdigit():
        return f"Voltage input {low[2:]}"

    if low.startswith("temp") and low[4:].isdigit():
        return f"Temp {low[4:]}"

    if low.startswith("thermistor"):
        number = original.split()[-1] if original.split() else ""
        return f"Thermistor {number}".strip()

    if low.startswith("diode"):
        number = original.split()[-1] if original.split() else ""
        return f"Diode {number}".strip()

    if low.startswith("intrusion"):
        number = re.sub(r"\D+", "", original)
        return f"Intrusion {number}".strip()

    return original


def short_cpu_token() -> str:
    """Short CPU model, e.g. 'AMD Ryzen 5 7500F 6-Core' -> '7500F'."""
    model = get_cpu_model()
    match = re.search(r"\b(\d{4,5}[A-Z]*)\b", model)
    if match:
        return match.group(1)
    return "CPU"


def short_gpu_token(model: str) -> str:
    """Short GPU model, e.g. 'Navi 44 [Radeon RX 9050 / 9060 XT]' -> '9060 XT'."""
    match = re.search(r"\b(\d{4}\s+[A-Z]{1,3})\b", model)
    if match:
        return re.sub(r"\s+", " ", match.group(1)).upper()
    match = re.search(r"\b(\d{4}[A-Z]*)\b", model)
    if match:
        return match.group(1)
    return "GPU"


def short_chip_token(chip: str) -> str:
    """Compact chip identifier, in the style of psensor names."""
    low = nice_name(chip).lower()
    cpu_low = get_cpu_model().lower()

    if low in {"k10temp", "zenpower", "cpu_amd"} or "amdcpu" in low or low.startswith("cpu_amd"):
        return short_cpu_token()
    if low in {"coretemp", "cpu_thermal"} or ("intel" in low and "cpu" in low):
        return short_cpu_token()
    if low == "cpu":
        return short_cpu_token() if ("amd" in cpu_low or "ryzen" in cpu_low or "intel" in cpu_low or "core" in cpu_low) else "CPU"
    if low.startswith(("nct668", "nct67", "nct677")) or "nuvoton" in low:
        return "MB"
    if "amdgpu" in low or low == "radeon":
        return short_gpu_token(get_amd_gpu_model())
    if "nvidia" in low:
        return short_gpu_token(get_nvidia_gpu_model())
    if low.startswith("nvme"):
        return "NVMe"
    if low == "system" or low in {"acpitz", "thermal"}:
        return "SYS"
    if low.startswith("iwlwifi") or "wifi" in low:
        return "WiFi"
    return nice_name(chip)


def short_label_token(label: str, category: str) -> str:
    """Compact label: Tctl -> TEMP, edge -> TEMP, CPU -> USAGE etc."""
    original = nice_name(label)
    low = original.lower()

    mapping = {
        "tctl": "TEMP",
        "tdie": "TEMP",
        "tccd1": "CCD1",
        "tccd2": "CCD2",
        "edge": "TEMP",
        "junction": "JUNC",
        "mem": "MEM",
        "cpu": "USAGE",
        "processor": "CPU",
        "processador": "CPU",
        "composite": "TEMP",
        "sensor 1": "TEMP1",
        "sensor 2": "TEMP2",
        "pch_chip_cpu_max_temp": "PCH MAX",
        "pch_chip_temp": "PCH",
        "pch_cpu_temp": "PCH CPU",
        "smbusmaster 0": "SMB0",
        "tsi0_temp": "TSI0",
        "vddgfx": "VDD",
    }

    if category == "Usage":
        if "vram free" in low or "vram livre" in low:
            return "VRAM FREE"
        if "vram total" in low:
            return "VRAM TOTAL"
        if "vram used" in low or "vram usada" in low:
            return "VRAM USED"
        if "vram" in low:
            return "VRAM"
        if "memory" in low or "memoria" in low:
            return "MEM USAGE"
        if "gpu" in low:
            return "USAGE"
        if low.startswith("ram"):
            return {
                "ram": "RAM",
                "ram used": "RAM USED",
                "ram free": "RAM FREE",
                "ram total": "RAM TOTAL",
                "ram usada": "RAM USED",
                "ram disponível": "RAM FREE",
            }.get(low, "RAM")

    if low in mapping:
        return mapping[low]

    match = re.match(r"^(fan|pwm|in|temp|curr|power)(\d+)$", low)
    if match:
        prefix = {"fan": "FAN", "pwm": "PWM", "in": "VIN", "temp": "TEMP", "curr": "I", "power": "P"}[match.group(1)]
        return f"{prefix}{match.group(2)}"

    match = re.match(r"^(voltage input|entrada de voltagem) (\d+)$", low)
    if match:
        return f"VIN{match.group(2)}"

    match = re.match(r"^intrusion (\d+)$", low)
    if match:
        return f"INTR{match.group(1)}"

    match = re.match(r"^intrusion(\d+)$", low)
    if match:
        return f"INTR{match.group(1)}"

    match = re.match(r"^auxtin(\d+)$", low)
    if match:
        return f"AUX{match.group(1)}"

    return re.sub(r"\s+", " ", original).upper()[:14]


def friendly_chip_name(chip: str) -> str:
    chip_clean = nice_name(chip)
    low = chip_clean.lower()
    cpu_model = get_cpu_model()

    if low in {"k10temp", "zenpower"} or "amdcpu" in low or low.startswith("cpu_amd"):
        return f"CPU AMD — {cpu_model}"

    if low in {"coretemp", "cpu_thermal"} or ("intel" in low and "cpu" in low):
        return f"CPU Intel — {cpu_model}"

    if low.startswith("nct668") or low.startswith("nct67") or low.startswith("nct677") or low.startswith("nuvoton"):
        return "Board — Nuvoton"

    if "amdgpu" in low or low == "radeon":
        return f"GPU AMD — {get_amd_gpu_model()}"

    if "nvidia" in low:
        return f"GPU NVIDIA — {get_nvidia_gpu_model()}"

    if low == "cpu":
        cpu_model = get_cpu_model()
        cpu_model_lower = cpu_model.lower()
        if "amd" in cpu_model_lower or "ryzen" in cpu_model_lower:
            return f"CPU AMD — {cpu_model}"
        if "intel" in cpu_model_lower or "core" in cpu_model_lower:
            return f"CPU Intel — {cpu_model}"
        return f"CPU — {cpu_model}"

    if low == "system":
        return "System"

    if low.startswith("nvme"):
        return "SSD NVMe"

    if low in {"acpitz", "thermal"}:
        return "System"

    if low.startswith("iwlwifi") or "wifi" in low:
        return "Wi-Fi"

    return chip_clean


def friendly_sensor_name(chip: str, label: str, category: str) -> str:
    """Short name shown in the table, inspired by psensor names."""
    chip_short = short_chip_token(chip)
    label_short = short_label_token(label, category)

    # Avoid duplication when the label already contains the GPU model.
    if label_short.upper() == chip_short.upper() or label_short.upper() in chip_short.upper():
        return label_short

    return f"{chip_short} {label_short}"


def friendly_sensor_full_name(chip: str, label: str) -> str:
    """Full name, kept only in the tooltip to identify the sensor."""
    return f"{friendly_chip_name(chip)} / {normalize_label(label)}"


