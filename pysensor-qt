    def fit_window_to_content(self):
        """Shrink the window to the smallest size that still shows the table content."""
        table = self.table
        columns_width = sum(table.columnWidth(index) for index in range(table.columnCount()))
        rows_height = sum(table.rowHeight(index) for index in range(table.rowCount()))

        if not table.horizontalHeader().isHidden():
            rows_height += table.horizontalHeader().height()
        if not table.verticalHeader().isHidden():
            columns_width += table.verticalHeader().width()
        if table.verticalScrollBar().isVisible():
            columns_width += table.verticalScrollBar().width()
        if table.horizontalScrollBar().isVisible():
            rows_height += table.horizontalScrollBar().height()

        content_width = columns_width + table.frameWidth() * 2 + 2
        content_height = rows_height + table.frameWidth() * 2 + 2

        # Force the layout to account for every row/column, then restore the normal
        # table minimum so the user can still resize the window freely afterwards.
        table.setMinimumSize(content_width, content_height)
        QApplication.processEvents()
        hint = self.minimumSizeHint()
        table.setMinimumSize(0, 0)

        screen = QApplication.primaryScreen()
        if screen:
            available = screen.availableGeometry()
            frame = self.frameGeometry()
            frame_width = max(0, frame.width() - self.width())
            frame_height = max(0, frame.height() - self.height())
            width = min(hint.width(), available.width() - frame_width)
            height = min(hint.height(), available.height() - frame_height)
        else:
            width, height = hint.width(), hint.height()

        self.resize(max(width, self.minimumWidth()), max(height, self.minimumHeight()))
        QApplication.processEvents()

    def on_fit_toggled(self, checked: bool):
        self.fit_on_startup = bool(checked)
        if self.fit_on_startup:
            self.fit_window_to_content()
        self.save_ui_settings()

    def update_timer_interval(self):
        self.timer.start(self.interval_spin.value() * 1000)

    def save_ui_settings(self):
        self.settings["hidden_sensors"] = sorted(self.hidden_sensors)
        self.settings["hidden_sensor_info"] = self.hidden_sensor_info
        self.settings["favorite_sensors"] = sorted(self.favorite_sensors)
        self.settings["favorite_sensor_info"] = self.favorite_sensor_info
        self.settings["show_only_favorites"] = self.show_only_favorites
        self.settings["category_visible"] = self.category_visible
        self.settings["hide_zero"] = self.hide_zero_check.isChecked()
        if hasattr(self, "order_combo"):
            self.settings["order_mode"] = (
                "Category" if self.order_combo.currentText() == "Cat" else "Hardware"
            )
        self.settings["fit_on_startup"] = self.fit_on_startup
        self.settings["window_size"] = [self.width(), self.height()]
        save_settings(self.settings)

    def closeEvent(self, event):
        self.save_ui_settings()
        super().closeEvent(event)

    def set_order_mode(self):
        self.save_ui_settings()
        self.render_table()

    def apply_minimal_preset(self, rows):
        """On first run, show only the essential sensors (psensor style)."""
        targets = [
            lambda row: row.category == "Usage" and row.key.lower() == "usage|cpu/cpu",
            lambda row: row.category == "Temp" and row.key.lower().endswith("/tctl"),
            lambda row: row.category == "Temp" and row.key.lower().endswith("/tccd1"),
            lambda row: row.category == "Temp" and "amdgpu/edge" in row.key.lower(),
        ]

        keys = []
        for matches in targets:
            key = next((row.key for row in rows if matches(row)), None)
            if key and key not in keys:
                keys.append(key)

        if not keys:
            return

        self.favorite_sensors = set(keys)
        self.favorite_sensor_info = {
            row.key: {"name": row.name, "category": row.category}
            for row in rows
            if row.key in keys
        }
        self.show_only_favorites = True
        if hasattr(self, "show_all_action"):
            self.show_all_action.setChecked(False)
        self.settings["minimal_mode_v2"] = True
        self.save_ui_settings()

    def set_only_favorites(self, enabled: bool):
        self.show_only_favorites = bool(enabled)
        if hasattr(self, "show_all_action"):
            self.show_all_action.setChecked(not self.show_only_favorites)
        self.save_ui_settings()
        self.render_table()

    def toggle_only_favorites(self):
        self.set_only_favorites(not self.show_only_favorites)

    def clear_favorites(self):
        self.favorite_sensors.clear()
        self.favorite_sensor_info.clear()
        self.save_ui_settings()
        self.render_table()

    def update_favorites_button(self):
        count = len(self.favorite_sensors)
        if self.show_only_favorites:
            self.favorites_button.setText(f"Fav ({count}) ✓")
            self.favorites_button.setToolTip("Showing favorites only. Click to show all sensors.")
        else:
            self.favorites_button.setText(f"Fav ({count})")
            self.favorites_button.setToolTip("Favorites. Click to show favorites only.")

    def set_hide_zero(self):
        self.save_ui_settings()
        self.render_table()

    def set_category_visible(self, category: str, visible: bool):
        self.category_visible[category] = bool(visible)
        if category in self.category_actions:
            self.category_actions[category].setChecked(bool(visible))
        self.save_ui_settings()
        self.render_table()

    def set_all_categories(self, visible: bool):
        for category in CATEGORIES:
            self.category_visible[category] = bool(visible)
            if category in self.category_actions:
                self.category_actions[category].setChecked(bool(visible))
        self.save_ui_settings()
        self.render_table()

    def choose_log_file(self):
        path, _ = QFileDialog.getSaveFileName(
            self,
            "Choose CSV file",
            str(Path.home() / "sensores.csv"),
            "CSV (*.csv);;All files (*)",
        )

        if path:
            self.log_path = Path(path)
            self.log_check.setChecked(True)
            if hasattr(self, "log_action"):
                self.log_action.setChecked(True)
            self.status_label.setText(f"Log CSV: {self.log_path}")

    def toggle_log(self):
        if self.log_check.isChecked() and self.log_path is None:
            self.log_path = Path.home() / "sensores.csv"
            self.status_label.setText(f"Log CSV: {self.log_path}")

    def reset_minmax(self):
        self.minmax.clear()
        self.refresh()

    def restore_all_sensors(self):
        self.hidden_sensors.clear()
        self.hidden_sensor_info.clear()
        self.save_ui_settings()
        self.render_table()

    def should_show(self, row: Reading) -> bool:
        selected = self.category_combo.currentText()
        if selected in ("Fav", "Favorites"):
            if row.key not in self.favorite_sensors:
                return False
        elif selected != "All" and row.category != selected:
            return False

        if self.show_only_favorites and row.key not in self.favorite_sensors:
            return False

        if not self.category_visible.get(row.category, True):
            return False

        if row.key in self.hidden_sensors:
            return False

        # "Hide zeros" is useful for unplugged fans, missing voltages and spare PWMs,
        # but it must not hide Usage, because 0% GPU/CPU is a valid idle reading.
        if self.hide_zero_check.isChecked() and row.numeric == 0 and row.category != "Usage":
            return False

        return True

    def refresh(self):
        rows = scan_sensors()
        self.last_rows = rows

        if not self.settings.get("minimal_mode_v2"):
            self.apply_minimal_preset(rows)

        if not rows:
            self.table.setRowCount(0)
            self.update_hidden_button()
            self.status_label.setText("No sensors found. Try: sensors")
            return

        for row in rows:
            self.hidden_sensor_info[row.key] = {
                "name": row.name,
                "category": row.category,
            }

            if row.key in self.favorite_sensors:
                self.favorite_sensor_info[row.key] = {
                    "name": row.name,
                    "category": row.category,
                }

            if row.numeric is None:
                continue

            if row.key not in self.minmax:
                self.minmax[row.key] = {"min": row.numeric, "max": row.numeric, "unit": row.unit}
            else:
                self.minmax[row.key]["min"] = min(self.minmax[row.key]["min"], row.numeric)
                self.minmax[row.key]["max"] = max(self.minmax[row.key]["max"], row.numeric)
                self.minmax[row.key]["unit"] = row.unit

        self.save_ui_settings()
        self.render_table()

        if self.log_check.isChecked():
            self.write_log(rows)

    def render_table(self):
        rows = [row for row in self.last_rows if self.should_show(row)]

        if self.order_combo.currentText() == "HW":
            rows.sort(key=lambda row: (
                hardware_group(row),
                CATEGORY_ORDER.get(row.category, 99),
                row.name.lower(),
            ))

        self.table.blockSignals(True)
        self.table.setRowCount(len(rows))

        for table_row, row in enumerate(rows):
            current = f"{row.value} {row.unit}".strip()

            min_value = "—"
            max_value = "—"

            if row.key in self.minmax:
                unit = self.minmax[row.key].get("unit", row.unit)

                if unit == "GB":
                    min_value = format_gb(self.minmax[row.key]["min"])
                    max_value = format_gb(self.minmax[row.key]["max"])
                else:
                    min_value = format_minmax(self.minmax[row.key]["min"], unit)
                    max_value = format_minmax(self.minmax[row.key]["max"], unit)

            hw_index = hardware_group(row)
            values = [
                row.category,
                hardware_tag(row),
                row.name,
                current,
                min_value,
                max_value,
            ]

            for offset, value in enumerate(values):
                item = QTableWidgetItem(value)
                item.setFlags(Qt.ItemFlag.ItemIsEnabled)
                item.setData(Qt.ItemDataRole.UserRole, row.key)

                if offset >= 3:
                    item.setTextAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)

                if offset == 1:
                    item.setTextAlignment(Qt.AlignmentFlag.AlignHCenter | Qt.AlignmentFlag.AlignVCenter)
                    item.setForeground(hardware_color(row))
                    font = item.font()
                    font.setBold(True)
                    item.setFont(font)
                    group_name = (
                        HARDWARE_GROUPS[hw_index][0]
                        if hw_index < len(HARDWARE_GROUPS)
                        else "Other"
                    )
                    item.setToolTip(f"{group_name} sensor")

                if offset == 2 and row.full_name:
                    item.setToolTip(row.full_name)

                if row.category == "Temp" and offset == 3 and row.numeric is not None:
                    if row.numeric >= 85:
                        item.setToolTip("High temperature")
                    elif row.numeric >= 70:
                        item.setToolTip("Warm temperature")

                if row.category == "Status" and str(row.value).upper() == "ALARM":
                    item.setToolTip("Sensor in alarm state")

                self.table.setItem(table_row, offset, item)

        self.table.clearSelection()
        self.table.setCurrentCell(-1, -1)
        self.table.blockSignals(False)

        now = datetime.now().strftime("%H:%M:%S")
        total = len(self.last_rows)
        shown = len(rows)
        hidden = len(self.hidden_sensors)
        hidden_categories = sum(1 for category in CATEGORIES if not self.category_visible.get(category, True))

        self.update_hidden_button()
        self.update_favorites_button()
        self.status_label.setText(
            f"{now} | {shown}/{total} sensors | ★ {len(self.favorite_sensors)}"
        )
        self.status_label.setToolTip(
            f"Last update: {now}\n"
            f"Shown: {shown}/{total}\n"
            f"Favorites: {len(self.favorite_sensors)}\n"
            f"Hidden sensors: {hidden}\n"
            f"Hidden categories: {hidden_categories}"
        )

        # The first readings can still be placeholders ("—"), so the initial fit is
        # too small. Re-fit whenever the rendered content changes size.
        if self.fit_on_startup:
            content_size = (
                sum(self.table.columnWidth(index) for index in range(self.table.columnCount())),
                sum(self.table.rowHeight(index) for index in range(self.table.rowCount())),
            )
            if content_size != getattr(self, "last_fit_content", None):
                self.last_fit_content = content_size
                QTimer.singleShot(0, self.fit_window_to_content)

    def hide_sensor(self, key: str):
        row = next((sensor for sensor in self.last_rows if sensor.key == key), None)
        if row:
            self.hidden_sensor_info[key] = {
                "name": row.name,
                "category": row.category,
            }
        self.hidden_sensors.add(key)
        self.save_ui_settings()
        self.render_table()

    def show_sensor(self, key: str):
        self.hidden_sensors.discard(key)
        self.save_ui_settings()
        self.render_table()

    def set_favorite(self, key: str, enabled: bool):
        if enabled:
            self.favorite_sensors.add(key)
            row = next((sensor for sensor in self.last_rows if sensor.key == key), None)
            if row:
                self.favorite_sensor_info[key] = {
                    "name": row.name,
                    "category": row.category,
                }
            elif key in self.hidden_sensor_info:
                self.favorite_sensor_info[key] = dict(self.hidden_sensor_info[key])
        else:
            self.favorite_sensors.discard(key)
            self.favorite_sensor_info.pop(key, None)
        self.save_ui_settings()
        self.render_table()

    def show_sensor_context_menu(self, pos):
        item = self.table.itemAt(pos)
        if not item:
            return

        key = item.data(Qt.ItemDataRole.UserRole)
        if not key or not any(row.key == key for row in self.last_rows):
            return

        menu = QMenu(self)
        is_favorite = key in self.favorite_sensors
        favorite_action = menu.addAction(
            "Remove from favorites" if is_favorite else "Add to favorites"
        )
        hide_action = menu.addAction("Hide sensor")

        chosen = menu.exec(self.table.viewport().mapToGlobal(pos))
        if chosen == favorite_action:
            self.set_favorite(key, not is_favorite)
        elif chosen == hide_action:
            self.hide_sensor(key)

    def update_hidden_button(self):
        count = len(self.hidden_sensors)
        self.hidden_button.setText(f"Hidden {count}")
        self.hidden_button.setToolTip(f"Hidden sensors ({count}). Click to manage them.")

    def show_hidden_dialog(self):
        if not self.hidden_sensors:
            QMessageBox.information(self, "Hidden sensors", "No sensors are hidden right now.")
            return

        dialog = QDialog(self)
        dialog.setWindowTitle("Hidden sensors")
        dialog.resize(720, 420)

        layout = QVBoxLayout()
        layout.addWidget(QLabel("Hidden sensors. Select one or more:"))

        hidden_list = QListWidget()
        hidden_list.setAlternatingRowColors(True)
        hidden_list.setSelectionMode(QAbstractItemView.SelectionMode.ExtendedSelection)
        hidden_list.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)

        def populate():
            hidden_list.clear()
            for key in sorted(
                self.hidden_sensors,
                key=lambda item: self.hidden_sensor_info.get(item, {}).get("name", item).lower(),
            ):
                info = self.hidden_sensor_info.get(key, {})
                name = info.get("name", key)
                category = info.get("category", "Sensor")
                item = QListWidgetItem(f"[{category}] {name}")
                item.setFlags(Qt.ItemFlag.ItemIsEnabled | Qt.ItemFlag.ItemIsSelectable)
                item.setData(Qt.ItemDataRole.UserRole, key)
                item.setToolTip("Right-click for options")
                hidden_list.addItem(item)

        populate()
        layout.addWidget(hidden_list)

        def selected_keys():
            return [item.data(Qt.ItemDataRole.UserRole) for item in hidden_list.selectedItems()]

        def show_selected():
            for key in selected_keys():
                self.hidden_sensors.discard(key)
            self.save_ui_settings()
            populate()
            self.render_table()

        def favorite_selected():
            for key in selected_keys():
                self.set_favorite(key, True)
            populate()

        def show_all():
            self.restore_all_sensors()
            populate()

        def show_hidden_menu(pos):
            item = hidden_list.itemAt(pos)
            if not item:
                return

            key = item.data(Qt.ItemDataRole.UserRole)
            menu = QMenu(dialog)
            show_action = menu.addAction("Show sensor")
            favorite_action = menu.addAction(
                "Remove from favorites" if key in self.favorite_sensors else "Add to favorites"
            )
            chosen = menu.exec(hidden_list.viewport().mapToGlobal(pos))
            if chosen == show_action:
                self.show_sensor(key)
                populate()
            elif chosen == favorite_action:
                self.set_favorite(key, key not in self.favorite_sensors)

        hidden_list.customContextMenuRequested.connect(show_hidden_menu)

        button_bar = QHBoxLayout()
        show_selected_button = QPushButton("Show selected")
        favorite_selected_button = QPushButton("Add selected to favorites")
        show_all_button = QPushButton("Show all")
        close_button = QPushButton("Close")

        show_selected_button.clicked.connect(show_selected)
        favorite_selected_button.clicked.connect(favorite_selected)
        show_all_button.clicked.connect(show_all)
        close_button.clicked.connect(dialog.reject)

        button_bar.addStretch()
        button_bar.addWidget(show_selected_button)
        button_bar.addWidget(favorite_selected_button)
        button_bar.addWidget(show_all_button)
        button_bar.addWidget(close_button)

        layout.addLayout(button_bar)
        dialog.setLayout(layout)
        dialog.exec()

    def write_log(self, rows):
        if self.log_path is None:
            self.log_path = Path.home() / "sensores.csv"

        try:
            self.log_path.parent.mkdir(parents=True, exist_ok=True)
            new_file = not self.log_path.exists()

            with self.log_path.open("a", newline="", encoding="utf-8") as file:
                writer = csv.writer(file)

                if new_file:
                    writer.writerow(["timestamp", "category", "sensor", "value", "unit"])

                timestamp = datetime.now().isoformat(timespec="seconds")

                for row in rows:
                    writer.writerow([timestamp, row.category, row.name, row.value, row.unit])

        except Exception as error:
            self.log_check.setChecked(False)
            QMessageBox.warning(
                self,
                "Log error",
                f"Could not write CSV:\n\n{error}",
            )


def main():
    app = QApplication(sys.argv)
    window = PySensorQt()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
