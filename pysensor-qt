def read_cpu_totals():
    """
    Read /proc/stat.
    Return total and idle ticks since boot.
    """
    line = ""
    try:
        line = Path("/proc/stat").read_text(errors="ignore").splitlines()[0]
    except Exception:
        return None

    parts = line.split()
    if not parts or parts[0] != "cpu":
        return None

    try:
        values = [int(value) for value in parts[1:]]
    except ValueError:
        return None

    if len(values) < 5:
        return None

    idle = values[3] + values[4]  # idle + iowait
    total = sum(values)
    return total, idle


def get_cpu_usage_percent():
    """
    Calculate CPU usage from the delta between reads.
    The first read uses a quick estimate to avoid a false 0.
    """
    global _LAST_CPU_TOTAL, _LAST_CPU_IDLE

    current = read_cpu_totals()
    if current is None:
        return None

    total, idle = current

    if _LAST_CPU_TOTAL is None or _LAST_CPU_IDLE is None:
        _LAST_CPU_TOTAL = total
        _LAST_CPU_IDLE = idle
        return None

    delta_total = total - _LAST_CPU_TOTAL
    delta_idle = idle - _LAST_CPU_IDLE

    _LAST_CPU_TOTAL = total
    _LAST_CPU_IDLE = idle

    if delta_total <= 0:
        return None

    usage = (1.0 - (delta_idle / delta_total)) * 100.0
    return max(0.0, min(100.0, usage))


def get_ram_info():
    """
    Usa MemAvailable para estimar uso real de RAM.
    Retorna valores em MB e percentual.
    """
    values = {}

    try:
        for line in Path("/proc/meminfo").read_text(errors="ignore").splitlines():
            if ":" not in line:
                continue

            key, value = line.split(":", 1)
            number = value.strip().split()[0]
            values[key] = int(number)
    except Exception:
        return None

    total_kb = values.get("MemTotal")
    available_kb = values.get("MemAvailable")

    if not total_kb or available_kb is None:
        return None

    used_kb = total_kb - available_kb

    total_gb = total_kb / 1024.0 / 1024.0
    used_gb = used_kb / 1024.0 / 1024.0
    available_gb = available_kb / 1024.0 / 1024.0
    percent = max(0.0, min(100.0, used_gb * 100.0 / total_gb))

    return {
        "used_gb": used_gb,
        "available_gb": available_gb,
        "total_gb": total_gb,
        "percent": percent,
    }


def get_ram_usage_percent():
    info = get_ram_info()
    if not info:
        return None
    return info["percent"]


def scan_basic_usage():
    rows = []

    cpu_model = get_cpu_model()
    if cpu_model != "CPU":
        add_reading(rows, "system", "Status", "Processor", cpu_model, "", None)

    cpu_usage = get_cpu_usage_percent()
    if cpu_usage is None:
        add_reading(rows, "cpu", "Usage", "CPU", "coletando", "%", None)
    else:
        add_reading(rows, "cpu", "Usage", "CPU", f"{cpu_usage:.0f}", "%", cpu_usage)

    ram_info = get_ram_info()
    if ram_info is not None:
        ram_usage = ram_info["percent"]
        add_reading(rows, "system", "Usage", "RAM", f"{ram_usage:.0f}", "%", ram_usage)

        used_gb = ram_info["used_gb"]
        available_gb = ram_info["available_gb"]
        total_gb = ram_info["total_gb"]

        add_reading(rows, "system", "Usage", "RAM used", f"{used_gb:.1f}", "GB", used_gb)
        add_reading(rows, "system", "Usage", "RAM free", f"{available_gb:.1f}", "GB", available_gb)
        add_reading(rows, "system", "Usage", "RAM total", f"{total_gb:.1f}", "GB", total_gb)

    return rows


def scan_nvidia_usage():
    global _LAST_NVIDIA_USAGE_ROWS, _LAST_NVIDIA_USAGE_TIME

    nvidia_smi = find_command("nvidia-smi")
    if not nvidia_smi:
        return cached_nvidia_usage_rows()

    try:
        result = subprocess.run(
            [
                nvidia_smi,
                "--query-gpu=name,utilization.gpu,utilization.memory,memory.used,memory.total",
                "--format=csv,noheader,nounits",
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=3,
            check=False,
        )
    except Exception:
        return cached_nvidia_usage_rows()

    if result.returncode != 0:
        return cached_nvidia_usage_rows()

    rows = []

    for line in result.stdout.splitlines():
        parts = [part.strip() for part in line.split(",")]
        if len(parts) < 5:
            continue

        name, gpu_usage, mem_usage, mem_used, mem_total = parts[:5]
        gpu = shorten_gpu_name(name)

        if valid_nvidia_value(gpu_usage):
            try:
                value = float(gpu_usage)
                add_reading(rows, "nvidia", "Usage", f"{gpu} GPU", f"{value:.0f}", "%", value)
            except ValueError:
                pass

        if valid_nvidia_value(mem_usage):
            try:
                value = float(mem_usage)
                add_reading(rows, "nvidia", "Usage", f"{gpu} memory controller", f"{value:.0f}", "%", value)
            except ValueError:
                pass

        if valid_nvidia_value(mem_used) and valid_nvidia_value(mem_total):
            try:
                used = float(mem_used)
                total = float(mem_total)
                if total > 0:
                    value = used * 100.0 / total
                    free = max(0.0, total - used)

                    used_gb = used / 1024.0
                    free_gb = free / 1024.0
                    total_gb = total / 1024.0

                    add_reading(rows, "nvidia", "Usage", f"{gpu} VRAM", f"{value:.0f}", "%", value)
                    add_reading(rows, "nvidia", "Usage", f"{gpu} VRAM used", f"{used_gb:.1f}", "GB", used_gb)
                    add_reading(rows, "nvidia", "Usage", f"{gpu} VRAM free", f"{free_gb:.1f}", "GB", free_gb)
                    add_reading(rows, "nvidia", "Usage", f"{gpu} VRAM total", f"{total_gb:.1f}", "GB", total_gb)
            except ValueError:
                pass

    if rows:
        _LAST_NVIDIA_USAGE_ROWS = list(rows)
        _LAST_NVIDIA_USAGE_TIME = time.monotonic()
    else:
        rows = cached_nvidia_usage_rows()

    return rows


def read_sysfs_float(path: Path):
    text = read_text(path)
    if not text:
        return None

    try:
        return float(text)
    except ValueError:
        return None


def scan_amdgpu_usage():
    rows = []
    seen_cards = set()

    for card in sorted(Path("/sys/class/drm").glob("card*")):
        if "-" in card.name:
            continue

        device = card / "device"
        if not device.exists():
            continue

        driver = ""
        try:
            driver = device.joinpath("driver").resolve().name.lower()
        except Exception:
            pass

        vendor = read_text(device / "vendor").lower()

        if driver != "amdgpu" and vendor != "0x1002":
            continue

        if str(device) in seen_cards:
            continue
        seen_cards.add(str(device))

        gpu_name = get_amd_gpu_model()

        busy_path = device / "gpu_busy_percent"
        busy = read_sysfs_float(busy_path)
        if busy is not None:
            value = max(0.0, min(100.0, busy))
            add_reading(rows, "amdgpu", "Usage", f"{gpu_name} GPU", f"{value:.0f}", "%", value)

        mem_busy_path = device / "mem_busy_percent"
        mem_busy = read_sysfs_float(mem_busy_path)
        if mem_busy is not None:
            value = max(0.0, min(100.0, mem_busy))
            add_reading(rows, "amdgpu", "Usage", f"{gpu_name} memory", f"{value:.0f}", "%", value)

        vram_used = read_sysfs_float(device / "mem_info_vram_used")
        vram_total = read_sysfs_float(device / "mem_info_vram_total")
        if vram_used is not None and vram_total and vram_total > 0:
            value = max(0.0, min(100.0, vram_used * 100.0 / vram_total))

            used_gb = vram_used / 1024.0 / 1024.0 / 1024.0
            total_gb = vram_total / 1024.0 / 1024.0 / 1024.0
            free_gb = max(0.0, total_gb - used_gb)

            add_reading(rows, "amdgpu", "Usage", f"{gpu_name} VRAM", f"{value:.0f}", "%", value)
            add_reading(rows, "amdgpu", "Usage", f"{gpu_name} VRAM used", f"{used_gb:.1f}", "GB", used_gb)
            add_reading(rows, "amdgpu", "Usage", f"{gpu_name} VRAM free", f"{free_gb:.1f}", "GB", free_gb)
            add_reading(rows, "amdgpu", "Usage", f"{gpu_name} VRAM total", f"{total_gb:.1f}", "GB", total_gb)

    return rows


def scan_usage():
    rows = []
    rows.extend(scan_basic_usage())
    rows.extend(scan_nvidia_usage())
    rows.extend(scan_amdgpu_usage())
    return rows

def scan_hwmon():
    rows = []

    if not HWMON.exists():
        return rows

    for hw in sorted(HWMON.glob("hwmon*")):
        chip = nice_name(read_text(hw / "name") or hw.name)

        for path in sorted(hw.glob("temp*_input")):
            match = re.match(r"temp(\d+)_input$", path.name)
            if not match:
                continue

            raw = read_int(path)
            if raw is None:
                continue

            value = hwmon_temp(raw)
            if value <= -100:
                continue

            number = match.group(1)
            add_reading(rows, chip, "Temp", label_for(hw, "temp", number), f"{value:.1f}", "°C", value)

        for path in sorted(hw.glob("fan*_input")):
            match = re.match(r"fan(\d+)_input$", path.name)
            if not match:
                continue

            raw = read_int(path)
            if raw is None:
                continue

            number = match.group(1)
            add_reading(rows, chip, "Fan", label_for(hw, "fan", number), str(raw), "RPM", float(raw))

        for path in sorted(hw.glob("in*_input")):
            match = re.match(r"in(\d+)_input$", path.name)
            if not match:
                continue

            raw = read_int(path)
            if raw is None:
                continue

            value = hwmon_voltage(raw)
            number = match.group(1)
            add_reading(rows, chip, "Volt", label_for(hw, "in", number), f"{value:.3f}", "V", value)

        for path in sorted(hw.glob("power*_input")):
            match = re.match(r"power(\d+)_input$", path.name)
            if not match:
                continue

            raw = read_int(path)
            if raw is None:
                continue

            value = hwmon_power(raw)
            number = match.group(1)
            add_reading(rows, chip, "Power", label_for(hw, "power", number), f"{value:.2f}", "W", value)

        for path in sorted(hw.glob("curr*_input")):
            match = re.match(r"curr(\d+)_input$", path.name)
            if not match:
                continue

            raw = read_int(path)
            if raw is None:
                continue

            value = hwmon_current(raw)
            number = match.group(1)
            add_reading(rows, chip, "Curr", label_for(hw, "curr", number), f"{value:.3f}", "A", value)

        for path in sorted(hw.glob("energy*_input")):
            match = re.match(r"energy(\d+)_input$", path.name)
            if not match:
                continue

            raw = read_int(path)
            if raw is None:
                continue

            value = hwmon_energy(raw)
            number = match.group(1)
            add_reading(rows, chip, "Energy", label_for(hw, "energy", number), f"{value:.2f}", "J", value)

        for path in sorted(hw.glob("pwm*")):
            match = re.match(r"pwm(\d+)$", path.name)
            if not match:
                continue

            raw = read_int(path)
            if raw is None:
                continue

            value = hwmon_pwm_percent(raw)
            if value is None:
                continue

            number = match.group(1)
            add_reading(rows, chip, "PWM", label_for(hw, "pwm", number), f"{value:.0f}", "%", value)

        for path in sorted(hw.glob("intrusion*_alarm")):
            match = re.match(r"intrusion(\d+)_alarm$", path.name)
            if not match:
                continue

            raw = read_int(path)
            if raw is None:
                continue

            number = match.group(1)
            add_reading(rows, chip, "Status", f"intrusion{number}", "ALARM" if raw else "OK", "", None)

    return rows


def scan_thermal_zones():
    rows = []

    if not THERMAL.exists():
        return rows

    for zone in sorted(THERMAL.glob("thermal_zone*")):
        raw = read_int(zone / "temp")
        if raw is None:
            continue

        value = hwmon_temp(raw)
        if value <= -100:
            continue

        add_reading(
            rows,
            "thermal",
            "Temp",
            read_text(zone / "type") or zone.name,
            f"{value:.1f}",
            "°C",
            value,
        )

    return rows


def valid_nvidia_value(value: str) -> bool:
    return value.strip().lower() not in {
        "",
        "[not supported]",
        "not supported",
        "[n/a]",
        "n/a",
        "na",
        "none",
        "unknown",
    }



def cache_valid(timestamp: float) -> bool:
    return (time.monotonic() - timestamp) <= NVIDIA_CACHE_SECONDS


def cached_nvidia_usage_rows():
    if _LAST_NVIDIA_USAGE_ROWS and cache_valid(_LAST_NVIDIA_USAGE_TIME):
        return list(_LAST_NVIDIA_USAGE_ROWS)
    return []


def cached_nvidia_sensor_rows():
    if _LAST_NVIDIA_SENSOR_ROWS and cache_valid(_LAST_NVIDIA_SENSOR_TIME):
        return list(_LAST_NVIDIA_SENSOR_ROWS)
    return []

def scan_nvidia_smi():
    global _LAST_NVIDIA_SENSOR_ROWS, _LAST_NVIDIA_SENSOR_TIME

    nvidia_smi = find_command("nvidia-smi")
    if not nvidia_smi:
        return cached_nvidia_sensor_rows()

    try:
        result = subprocess.run(
            [
                nvidia_smi,
                "--query-gpu=name,temperature.gpu,fan.speed,power.draw",
                "--format=csv,noheader,nounits",
            ],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=3,
            check=False,
        )
    except Exception:
        return cached_nvidia_sensor_rows()

    if result.returncode != 0:
        return cached_nvidia_sensor_rows()

    rows = []

    for line in result.stdout.splitlines():
        parts = [part.strip() for part in line.split(",")]
        if len(parts) < 4:
            continue

        name, temp, fan, power = parts[:4]
        gpu = shorten_gpu_name(name)

        if valid_nvidia_value(temp):
            try:
                value = float(temp)
                add_reading(rows, "nvidia", "Temp", f"{gpu} GPU", f"{value:.1f}", "°C", value)
            except ValueError:
                pass

        if valid_nvidia_value(fan):
            try:
                value = float(fan)
                add_reading(rows, "nvidia", "Fan", f"{gpu} Fan", f"{value:.0f}", "%", value)
            except ValueError:
                pass

        if valid_nvidia_value(power):
            try:
                value = float(power)
                add_reading(rows, "nvidia", "Power", f"{gpu} Power", f"{value:.2f}", "W", value)
            except ValueError:
                pass

    if rows:
        _LAST_NVIDIA_SENSOR_ROWS = list(rows)
        _LAST_NVIDIA_SENSOR_TIME = time.monotonic()
    else:
        rows = cached_nvidia_sensor_rows()

    return rows


def scan_sensors():
    rows = scan_usage()
    hwmon_rows = scan_hwmon()
    rows.extend(hwmon_rows)

    if not hwmon_rows:
        rows.extend(scan_thermal_zones())

    existing_names = " ".join(row.name.lower() for row in hwmon_rows)
    if "nvidia" not in existing_names:
        rows.extend(scan_nvidia_smi())

    merged = {}
    for row in rows:
        merged[row.key] = row

    return sorted(
        merged.values(),
        key=lambda row: (
            CATEGORY_ORDER.get(row.category, 99),
            row.name.lower(),
            row.unit,
        ),
    )


def format_minmax(value: float | None, unit: str) -> str:
    if value is None:
        return "—"

    if unit == "°C":
        return f"{value:.1f} °C"
    if unit == "RPM":
        return f"{value:.0f} RPM"
    if unit == "%":
        return f"{value:.0f} %"
    if unit == "V":
        return f"{value:.3f} V"
    if unit == "W":
        return f"{value:.2f} W"
    if unit == "A":
        return f"{value:.3f} A"
    if unit == "J":
        return f"{value:.2f} J"
    if unit == "GB":
        return format_gb(value)

    return f"{value:.2f} {unit}".strip()


class PySensorQt(QMainWindow):
