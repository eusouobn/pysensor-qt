        self.setWindowTitle("PySensor Qt")
        self.setMinimumSize(360, 180)

        self.settings = load_settings()
        self.fit_on_startup = bool(self.settings.get("fit_on_startup", True))
        saved_size = self.settings.get("window_size", [720, 380])
        try:
            self.resize(max(360, int(saved_size[0])), max(180, int(saved_size[1])))
        except (TypeError, ValueError, IndexError):
            self.resize(720, 380)
        self.hidden_sensors = set(self.settings.get("hidden_sensors", []))
        self.hidden_sensor_info = self.settings.get("hidden_sensor_info", {})
        self.favorite_sensors = set(self.settings.get("favorite_sensors", []))
        self.favorite_sensor_info = self.settings.get("favorite_sensor_info", {})
        self.show_only_favorites = bool(self.settings.get("show_only_favorites", False))
        self.category_visible = self.settings.get("category_visible", {category: True for category in CATEGORIES})

        self.minmax = {}
        self.log_path = None
        self.last_rows = []
        self.category_actions = {}

        self.table = QTableWidget(0, 6)
        self.table.setHorizontalHeaderLabels(["Type", "HW", "Sensor", "Now", "Min", "Max"])
