def hardware_tag(row) -> str:
    """Short badge shown next to each sensor name."""
    index = hardware_group(row)
    return HARDWARE_TAGS[index] if index < len(HARDWARE_TAGS) else "OTH"


def hardware_color(row) -> QColor:
    index = hardware_group(row)
    return QColor(HARDWARE_COLORS[index] if index < len(HARDWARE_COLORS) else "#90A4AE")


def hardware_group(row) -> int:
    """Hardware group used by the sort order (CPU, GPU, board...)."""
    try:
        chip = row.key.split("|", 1)[1].split("/", 1)[0].lower()
    except (IndexError, AttributeError):
        chip = str(getattr(row, "key", "")).lower()

    for index, (_title, prefixes) in enumerate(HARDWARE_GROUPS):
        if any(chip.startswith(prefix) or prefix in chip for prefix in prefixes):
            return index
    return len(HARDWARE_GROUPS)


