        self.hide_zero_check.setToolTip("Hide zeroed sensors, except Usage")
        self.hide_zero_check.setChecked(bool(self.settings.get("hide_zero", False)))
        self.hide_zero_check.stateChanged.connect(lambda _state: self.set_hide_zero())

        self.favorites_button = QPushButton("Fav (0)")
        self.favorites_button.clicked.connect(lambda _checked=False: self.toggle_only_favorites())

        self.hidden_button = QPushButton("Hidden")
        self.hidden_button.setToolTip("Hidden sensors")
        self.hidden_button.clicked.connect(lambda _checked=False: self.show_hidden_dialog())

